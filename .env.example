# Export these before starting the API. .env is NOT automatically loaded.
# Relative model paths are resolved from the repository/package root, not cwd.
CYBERGUARD_NETWORK_MODEL_PATH=models/network/bot_iot_restricted_baseline.joblib
# Optional independent NF-CSE artifact + frozen evaluation metadata (no datasets needed).
CYBERGUARD_NF_CSE_MODEL_PATH=models/network/nf_cse_binary_completed_flow.joblib
CYBERGUARD_NF_CSE_EVALUATION_DIR=reports/model_evaluation/nf_cse_binary/final_test
# Byte cap for POST /api/v1/models/*, including chunked bodies. Legacy routes unchanged.
CYBERGUARD_MAX_MODEL_REQUEST_BYTES=1048576
CYBERGUARD_API_HOST=127.0.0.1
CYBERGUARD_API_PORT=8000
CYBERGUARD_MAX_BATCH_SIZE=1000
CYBERGUARD_LOG_LEVEL=INFO
# Dashboard HTTP destination; independent of the backend bind address/port.
CYBERGUARD_API_URL=http://127.0.0.1:8000
